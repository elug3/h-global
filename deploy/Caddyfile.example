# Production on H-Global's server (plan 7.2). Caddy gets HTTPS certificates
# automatically. Replace the domains; hg-server listens on :8080 inside the
# Docker network. `handle` blocks keep the API from being rewritten to
# index.html by the single-page-app fallback.

studio.hglobal.example {
	handle /studio-api/* {
		reverse_proxy hg-server:8080 {
			# Server-Sent Events and the MJPEG preview must not be buffered.
			flush_interval -1
		}
	}
	handle /media/* {
		reverse_proxy hg-server:8080
	}
	handle {
		# H-Global Studio: static files from `npm run build` in hg-studio/
		root * /srv/hg-studio
		try_files {path} /index.html
		file_server
	}
}

# storefront (not built yet) will proxy /api the same way.

