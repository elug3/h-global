{
  "name": "storefront",
  "private": true,
  "version": "0.1.0",
  "description": "H-Global storefront: the customer website (live page, products, checkout, orders). Server-rendered.",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router typegen && tsc --noEmit && react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "gen:api": "openapi-typescript ../api/openapi.yaml --default-non-nullable false -o app/api/schema.d.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@react-router/node": "8.5.0",
    "@react-router/serve": "8.5.0",
    "isbot": "5.1.30",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.5.0",
    "@types/node": "22.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
