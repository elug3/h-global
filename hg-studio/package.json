{
  "name": "hg-studio",
  "private": true,
  "version": "0.1.0",
  "description": "H-Global Studio: the staff web app (stream setup, live console).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ../api/openapi.yaml --default-non-nullable false -o src/api/schema.d.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
